# ============================================
# AVORNI COFFEE POS — Environment Variables
# Copy these keys into Vercel Dashboard > Project Settings > Environment Variables
# ============================================

# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-supabase-project.supabase.co

# Supabase Service Role Key (secret, used by backend serverless functions)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Anon Key (public, used by client side if realtime SDK enabled)
SUPABASE_ANON_KEY=your-supabase-anon-key
